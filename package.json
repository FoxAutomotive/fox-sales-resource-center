{
  "name": "fox-sales-resource-center",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Static automotive product reference for Fox Automotive",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "validate": "node scripts/validate.mjs",
    "test": "node --test --test-isolation=none tests/data.test.mjs tests/import.test.mjs tests/specials.test.mjs tests/model-years.test.mjs tests/gm-import.test.mjs tests/presentation.test.mjs tests/toyota-import.test.mjs",
    "test:browser": "playwright test",
    "build": "node scripts/build.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:extractor": "python -m unittest discover -s tests/import -p \"test_*.py\"",
    "import:pdf": "node scripts/import/import-pdf.mjs",
    "import:apply": "node scripts/import/apply-import.mjs",
    "import:gm": "node scripts/import/import-gm.mjs",
    "import:toyota": "node scripts/import/import-toyota.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1",
    "prettier": "3.6.2"
  }
}
